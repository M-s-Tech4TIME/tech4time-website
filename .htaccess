# ==========================================================================
# Tech4TIME — Apache configuration for cPanel shared hosting
#
# This file carries the security headers, compression and caching rules. It is
# the authoritative source for headers: several of them (X-Frame-Options,
# X-Content-Type-Options) are ignored by browsers when set via <meta>, so the
# equivalents in each page's <head> are defence in depth only.
#
# Every directive is wrapped in <IfModule> so a host missing a module degrades
# rather than returning a 500.
# ==========================================================================

# --------------------------------------------------------------------------
# 1. Security headers
# --------------------------------------------------------------------------
<IfModule mod_headers.c>
    # The site is self-hosted: no CDN, no third-party fonts and no embeds.
    # 'unsafe-inline' is deliberately absent — there are no inline <script> or
    # <style> blocks anywhere in the site.
    #
    # THE GOOGLE ORIGINS ARE THE ONE EXCEPTION, AND THIS IS NOT WHERE IT IS
    # DECIDED. A header cannot read content/seo.json, so it cannot know whether
    # anybody has asked for Google Analytics; naming the origins here is what
    # makes it POSSIBLE to switch on from the editor. What decides is the
    # <meta> policy lib/head.php sends with every page, which stays
    # script-src 'self' until a measurement id is set — and a browser enforces
    # every policy it is handed, so the stricter of the two is what applies.
    #
    # Clearing the id in the editor closes it again on the next request. There
    # is no deploy in that loop, and there must not be. See ADR 0021.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"

    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set X-Permitted-Cross-Domain-Policies "none"

    # HSTS — ON. Enabled once the site was live on the host and pages had been
    # loaded over https://tech4time.bd, which was the one precondition.
    #
    # WHAT IT DOES
    # Without it a browser asks for http://tech4time.bd first and is redirected
    # to https, and that first request travels in the open. This tells the
    # browser to remember, for a year, never to ask over plain http again — so
    # after one visit that unencrypted request stops happening. It matters here
    # because a sign-in lives at /admin: a password and an authenticator code
    # go over that connection, and a redirect protects neither on the hop
    # before it.
    #
    # THE ONE COST
    # A browser keeps obeying it even if https later breaks, and there is no
    # way to clear it remotely. cPanel AutoSSL renews certificates on its own,
    # which is what makes that unlikely enough to be worth it.
    #
    # NO includeSubDomains, DELIBERATELY — and this now has a date on it.
    # It would cover subdomains that do not exist yet. AutoSSL issues a
    # certificate on its next scheduled run after a subdomain is created, not
    # instantly — and in that window this header would make the new subdomain
    # unreachable rather than merely insecure. admin.tech4time.bd is exactly
    # that subdomain, and it is created by the repository split. Leave this off
    # until AutoSSL has issued for it; turning it on before would lock the
    # admin out of its own host.
    #
    # Do NOT add "preload". That submits the domain to a list compiled into
    # Chrome and Firefox, takes months to reverse, and only protects the very
    # first visit a browser ever makes.
    Header always set Strict-Transport-Security "max-age=31536000"

    # Do not advertise the stack.
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ----------------------------------------------------------------------
    # 2. Canonical host and scheme
    # Verified against the live server: HTTPS answers and the certificate
    # covers tech4time.bd and www.tech4time.bd (cPanel AutoSSL, Let's Encrypt).
    #
    # This is not only an SEO tidy-up. /admin is protected by HTTP Basic auth,
    # which sends the password base64-encoded — that is encoding, not
    # encryption. Over plain http it is readable by anything on the path. The
    # redirect is what stops that being possible.
    # ----------------------------------------------------------------------
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    # ----------------------------------------------------------------------
    # 3. Clean URLs
    # /pages/about/index.html resolves at /pages/about/ through DirectoryIndex
    # already. These rules make that the ONLY address the page answers on, so
    # the same content is not reachable at three URLs (a duplicate-content
    # problem the canonical tag would otherwise have to paper over).
    # ----------------------------------------------------------------------

    # Send /pages/about/index.html -> /pages/about/, and the same for the
    # pages that render from content/ and are therefore index.php: the home
    # page, careers, contact, the company profile and about. Both extensions,
    # because DirectoryIndex serves either and a page reachable at both its
    # directory AND its filename is the duplicate-content problem these rules
    # exist to prevent. It answered 200 at /pages/about/index.php until this
    # covered .php as well.
    RewriteCond %{THE_REQUEST} \s/(.*/)?index\.(html|php)[\s?] [NC]
    RewriteRule ^(.*/)?index\.(html|php)$ /%1 [R=301,L]

    # ----------------------------------------------------------------------
    # The sitemap is generated, and its ADDRESS MUST NOT CHANGE
    # /sitemap.xml is the URL robots.txt names and the one submitted to Search
    # Console, and a sitemap is a URL a crawler remembers. It stopped being a
    # static file when services became rows in a document rather than files in
    # this repository; it did not stop being that address.
    #
    # The rewrite is internal and unconditional: unconditional so that a
    # sitemap.xml left behind on the host by an older deploy cannot shadow the
    # generated one, internal so the address a crawler holds still answers.
    #
    # The first rule sends anyone who asks for /sitemap.php by name to the real
    # address, so the sitemap is not served at two URLs. It is guarded on
    # THE_REQUEST — the original request line, which an internal rewrite does
    # not change — because matching the rewritten path instead would send the
    # second rule's output straight back into the first, forever.
    # ----------------------------------------------------------------------
    RewriteCond %{THE_REQUEST} \s/sitemap\.php[\s?] [NC]
    RewriteRule ^sitemap\.php$ /sitemap.xml [R=301,L]

    RewriteRule ^sitemap\.xml$ /sitemap.php [L]

    # robots.txt and site.webmanifest, the same way and for the same reasons
    # ----------------------------------------------------------------------
    # Both stopped being static files when their contents came under the
    # editor: the crawl rules and the app's name, description and colours are
    # fields in content/seo.json now. Neither address changed, and neither may
    # -- /robots.txt is where every crawler looks and nowhere else, and
    # /site.webmanifest is named by a <link rel="manifest"> in every page that
    # has already been cached by returning visitors.
    #
    # Same shape as the sitemap above: a 301 for anyone who asks for the .php
    # file by name so neither is served at two URLs, guarded on THE_REQUEST so
    # the internal rewrite below does not feed itself back into it; then the
    # unconditional internal rewrite, so a stale robots.txt or site.webmanifest
    # left on the host by an older deploy cannot shadow the generated one.
    RewriteCond %{THE_REQUEST} \s/robots\.php[\s?] [NC]
    RewriteRule ^robots\.php$ /robots.txt [R=301,L]

    RewriteRule ^robots\.txt$ /robots.php [L]

    RewriteCond %{THE_REQUEST} \s/manifest\.php[\s?] [NC]
    RewriteRule ^manifest\.php$ /site.webmanifest [R=301,L]

    RewriteRule ^site\.webmanifest$ /manifest.php [L]

    # /favicon.ico, which had no answer at all
    # ----------------------------------------------------------------------
    # A browser probes this address BLINDLY: before it has read a line of the
    # page, before any <link>, and on requests that have no page. There was no
    # file at the root and no rule, so every one of those probes was a 404 --
    # an error in the log on every cold visit.
    #
    # It is generated now, because the mark is content: favicon.php assembles
    # the container from the PNGs content/settings.json names, and falls back
    # to the committed file. Same shape as the three above -- a 301 for anyone
    # who asks for the .php by name, guarded on THE_REQUEST so the internal
    # rewrite does not feed itself back into it, then the unconditional
    # internal rewrite so a favicon.ico left at the root by an older deploy
    # cannot shadow the generated one.
    RewriteCond %{THE_REQUEST} \s/favicon\.php[\s?] [NC]
    RewriteRule ^favicon\.php$ /favicon.ico [R=301,L]

    RewriteRule ^favicon\.ico$ /favicon.php [L]

    # /assets/css/brand.css, which is colours and not a file
    # ----------------------------------------------------------------------
    # The Content Security Policy is style-src 'self': no <style> block, no
    # style= attribute. A colour somebody picked in the editor has to reach the
    # page as a STYLESHEET or it does not reach the page at all. So it is
    # generated, the same way the four above are, and served from the address
    # every page's <link> already names.
    #
    # No 301 for the .php by name, unlike the four above: this one is under
    # assets/, which section 2 already serves with a year-long cache, and a
    # redirect there would be a second round trip on a render-blocking
    # stylesheet. The internal rewrite alone is what is needed.
    RewriteRule ^assets/css/brand\.css$ /assets/css/brand.css.php [L]

    # Send /pages/about -> /pages/about/  (only where the directory exists)
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_URI} !/$
    RewriteRule ^(.*)$ /$1/ [R=301,L]

    # ----------------------------------------------------------------------
    # A service page that has no directory
    # The six services were built as directories and are still served by them:
    # both conditions below are !-f and !-d, so a request that resolves to
    # something real never reaches these rules. A SEVENTH service, added in the
    # editor, exists only inside content/services.json — nothing in this
    # repository runs when content is published and the editor cannot create
    # directories here — so its clean URL matches nothing on disk and is routed
    # to the shared renderer instead.
    #
    # pages/services/detail.php answers 404 for a slug the document does not
    # have, or whose service is hidden, so this does not turn every unknown
    # address under /pages/services/ into a page.
    #
    # The rule is duplicated in tools/dev-router.php, which serves the local
    # preview: neither file reads the other, and a route that exists in only
    # one of them is a route that works in only one place.
    # ----------------------------------------------------------------------

    # First to the trailing slash, so the address has the same shape as the six.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^pages/services/([a-z0-9-]+)$ /pages/services/$1/ [R=301,L]

    # Then to the renderer. Internal: the address the visitor sees does not
    # change, and detail.php redirects anyone who asks for it by name.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^pages/services/([a-z0-9-]+)/$ /pages/services/detail.php?service=$1 [L,QSA]
</IfModule>

<IfModule mod_dir.c>
    DirectoryIndex index.php index.html
</IfModule>

# --------------------------------------------------------------------------
# 4. Error documents
# --------------------------------------------------------------------------
ErrorDocument 404 /404.php

# Never expose directory listings for asset folders.
Options -Indexes

# --------------------------------------------------------------------------
# 5. Compression
# woff2, WebP, PNG and JPEG are already compressed; re-compressing them wastes
# CPU for no gain, so only text formats are listed.
# --------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/ld+json
    AddOutputFilterByType DEFLATE application/xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE application/manifest+json
</IfModule>

# --------------------------------------------------------------------------
# 6. Caching
# Assets are cached hard. HTML is revalidated so content edits go live at once.
# NOTE: asset filenames are not content-hashed (there is no build step), so a
# changed CSS or JS file needs a cache-busting query string — or a shorter
# max-age here — to reach returning visitors. See README.md.
# --------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                          "access plus 1 month"

    ExpiresByType text/html                 "access plus 0 seconds"
    ExpiresByType application/ld+json       "access plus 0 seconds"

    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"

    ExpiresByType image/png                 "access plus 6 months"
    ExpiresByType image/jpeg                "access plus 6 months"
    ExpiresByType image/webp                "access plus 6 months"
    ExpiresByType image/avif                "access plus 6 months"
    ExpiresByType image/svg+xml             "access plus 6 months"
    ExpiresByType image/x-icon              "access plus 6 months"

    ExpiresByType application/xml           "access plus 1 day"
    ExpiresByType text/plain                "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>

    <FilesMatch "\.(png|jpe?g|webp|avif|svg|ico)$">
        Header set Cache-Control "public, max-age=15552000"
    </FilesMatch>

    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>

# --------------------------------------------------------------------------
# 7. MIME types
# Older Apache builds on shared hosting often lack these, which makes the
# browser refuse the font or image.
# --------------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType font/woff2                      .woff2
    AddType image/webp                      .webp
    AddType image/avif                      .avif
    AddType image/svg+xml                   .svg
    AddType application/manifest+json       .webmanifest
    AddType application/ld+json             .jsonld

    # The browser-facing view of sitemap.xml. This is NOT cosmetic wiring: the
    # site sends X-Content-Type-Options: nosniff, so a stylesheet served as
    # text/plain is refused and the sitemap falls back to raw XML.
    AddType text/xsl                        .xsl
</IfModule>

# --------------------------------------------------------------------------
# 8. Block access to non-public files
# The repo ships tooling and docs alongside the site; if the whole tree is ever
# uploaded, these must not be readable over HTTP.
#
# That has happened. The whole repository was unpacked into the document root
# on the first deploy, and this section did not keep the promise above: the
# FilesMatch below matches a FILENAME, so /.git/HEAD — file "HEAD", no leading
# dot, no blocked extension — was never covered by it, and neither was the
# 63 MB tech4time-website.zip sitting beside index.html with every commit in it.
# The host answered 403 for .git by a rule of its own. That rule is not ours
# and will not exist on a server we run, so it is not a defence, only luck.
# --------------------------------------------------------------------------

# Kept, but it is not the fix — see the rewrite block below, which is what
# actually covers a directory whose name begins with a dot.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Archives, dumps and logs join the list for the same reason the zip did: the
# protection should not depend on nobody ever leaving one here.
<FilesMatch "\.(md|py|sh|json|lock|yml|yaml|zip|tar|gz|tgz|bz2|rar|7z|sql|bak|log|env|ini)$">
    Require all denied
</FilesMatch>

# Written by the server into whatever directory the error happened in, and it
# names paths and line numbers. No extension, so the rule above cannot see it.
<Files "error_log">
    Require all denied
</Files>

# There is no site.webmanifest file any more, and so no exception for one.
# /site.webmanifest is an internal rewrite onto manifest.php (section 3), and
# the rewrite is unconditional, so a stale copy left by an older deploy is
# never served either. The exception that stood here granted access to a file
# that no longer ships; it is gone rather than left to be read as a rule.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^tools/ - [F,L]

    # references/ is working material — demos and notes kept beside the site.
    # It is .html, which nothing above blocks, and it was readable on the host
    # for as long as the unpacked repository sat there.
    RewriteRule ^references/ - [F,L]

    # Any path segment beginning with a dot, at any depth: .git/, .svn/, .env,
    # .claude/, editor droppings. This is the rule that closes the hole
    # described in section 8 — <FilesMatch "^\."> only ever saw the last
    # component of the path, so /.git/HEAD was the file "HEAD" to it and passed
    # straight through. (^|/) makes the dot's position the test instead.
    #
    # .well-known is the one exception and must stay reachable: AutoSSL answers
    # ACME challenges from there, and blocking it breaks certificate renewal
    # — which fails silently, months later, as an expired certificate.
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule "(^|/)\." - [F,L]

    # lib/ holds PHP that pages include; content/ holds the data the editors
    # write — job posts and the contact page. Both are read from disk by PHP
    # and must never be fetched over HTTP. The .json rule above already covers
    # those two files, but a directory rule survives someone adding a third in
    # another format.
    RewriteRule ^lib/ - [F,L]
    RewriteRule ^content/ - [F,L]

    # uploads/ is the opposite case: it must be SERVED, and it holds files that
    # arrived over the network. So it gets an allow-list rather than a block —
    # sixteen hex characters, a dot, and one of four extensions, which is
    # exactly the shape api/publish-asset.php computes from the bytes. A
    # request for anything else under uploads/ is refused before any handler
    # sees it, so a .php there could not be run even if one existed.
    #
    # This is the FOURTH of five independent layers, and one of the two that
    # hold if the others are wrong. The first is that the bytes are the
    # sanitiser's own output — gd's, for a raster; lib/svg.php's, for a vector
    # — and never an uploader's file. The second is that the receiving host
    # proves that for itself rather than trusting the sender. The third is that
    # the name is computed here from those bytes and never sent, so nothing an
    # uploader chose reaches a filesystem call. See ADR 0019.
    RewriteCond %{REQUEST_URI} !^/uploads/[0-9a-f]{16}\.(webp|jpe?g|png|svg)$
    RewriteRule ^uploads/. - [F,L]

    # THE FIFTH LAYER, AND THE ONE THAT MAKES A VECTOR FILE SAFE TO SERVE AT
    # ALL. Sanitising an SVG leaves a document, and a document in this origin
    # is a document that could act in it. So an .svg under uploads/ is never
    # served as one: Content-Disposition makes a browser save it rather than
    # render it, and the CSP is a second answer in case something navigates to
    # it anyway — no scripts, no fetches, no same-origin anything.
    #
    # Nothing on this site draws these files. The branding page LINKS to them;
    # its previews are raster. The download="" attribute names the file for the
    # visitor; this is what makes the address itself harmless.
    #
    # expr= rather than <FilesMatch> so the PATH is matched and not just the
    # name — the rule must apply under uploads/ and nowhere else. Same form as
    # the /admin and /api rules further down.
    <IfModule mod_headers.c>
        Header always set Content-Disposition "attachment" "expr=%{REQUEST_URI} =~ m#^/uploads/[0-9a-f]{16}\.svg$#"
        Header always set Content-Security-Policy "default-src 'none'; sandbox" "expr=%{REQUEST_URI} =~ m#^/uploads/[0-9a-f]{16}\.svg$#"
    </IfModule>


    # The private store — password hashes, the master key, sessions, the audit
    # log — belongs BESIDE the document root, at /home/USER/t4t-private, and
    # lib/private.php refuses to run if it finds itself anywhere inside this
    # directory. This rule is for the one case that check cannot help with:
    # somebody restoring a backup and dropping the folder in here by hand.
    RewriteRule ^t4t-private/ - [F,L]
</IfModule>

# --------------------------------------------------------------------------
# 9. The editors
# /admin/ has its own accounts now: a password hashed with argon2id, a second
# factor from an authenticator app, and a lockout. See lib/auth.php.
#
# It used to be protected by cPanel Directory Privacy instead, and while both
# are in place that is belt and braces — but the application is the lock, not
# Apache. Nothing here grants or denies access; this only keeps the editor out
# of search results.
# --------------------------------------------------------------------------
# `always` is the operative word: without it the header is attached only to
# 2xx responses, and the login page answers a crawler with 200 while every
# other admin URL answers with a redirect — none of which should be indexed.
# noarchive keeps a cached copy out of results as well as the page itself.
#
# no-store matters more than it used to. There was nothing behind Basic auth
# for a browser to cache without a password; there is now a signed-in editor,
# and a shared machine should not be able to press Back into it.
<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive" "expr=%{REQUEST_URI} =~ m#^/admin(/|$)#"
    Header always set Cache-Control "no-store, max-age=0" "expr=%{REQUEST_URI} =~ m#^/admin(/|$)#"

    # /api/ is where the admin host pushes content in. api/publish.php sets
    # both of these itself; these are here for the same reason as everything
    # else in this section — the application is the lock, and this only keeps
    # the endpoint out of search results and out of shared caches. An indexed
    # POST endpoint is not a vulnerability, but it is a URL in a result page
    # that invites people to find out what it does.
    Header always set X-Robots-Tag "noindex, nofollow, noarchive" "expr=%{REQUEST_URI} =~ m#^/api(/|$)#"
    Header always set Cache-Control "no-store, max-age=0" "expr=%{REQUEST_URI} =~ m#^/api(/|$)#"
</IfModule>
